    "That file doesn't look like a Keyholdr vault export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei scheint kein Keyholdr-Tresorexport zu sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no parece una exportación de bóveda de Keyholdr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier ne semble pas être un export de coffre Keyholdr."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはKeyholdrの保管庫の書き出しファイルではないようです。"
