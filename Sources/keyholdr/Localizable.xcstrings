    },
    "This permanently erases the secret from your macOS Keychain. This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird das Secret dauerhaft aus deinem macOS-Schlüsselbund gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El secreto se borrará para siempre de tu llavero de macOS. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le secret sera définitivement effacé de votre trousseau macOS. Cette action est irréversible."
