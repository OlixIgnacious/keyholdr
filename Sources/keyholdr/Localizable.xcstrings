        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件似乎不是 Keyholdr 保险库导出文件。"
          }
        }
      }
    },
    "The App Store build is sandboxed, which limits its command-line tool. For the terminal — including the full-screen keyholdr UI — install the Homebrew or direct-download build:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Store-Version läuft in einer Sandbox, die ihr Befehlszeilenwerkzeug einschränkt. Für das Terminal – einschließlich der Vollbild-Oberfläche von keyholdr – installiere die Homebrew-Version oder den direkten Download:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión de la App Store está aislada en un sandbox, lo que limita su herramienta de línea de comandos. Para la terminal, incluida la interfaz a pantalla completa de keyholdr, instala la versión de Homebrew o la de descarga directa:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version App Store est en sandbox, ce qui limite son outil en ligne de commande. Pour le terminal, y compris l’interface plein écran de keyholdr, installez la version Homebrew ou en téléchargement direct :"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store版はサンドボックス化されているため、コマンドラインツールに制限があります。ターミナルで使う場合（全画面のkeyholdr UIを含む）は、Homebrew版または直接ダウンロード版をインストールしてください:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 版本运行在沙盒中，其命令行工具受到限制。若要在终端中使用（包括全屏 keyholdr 界面），请安装 Homebrew 版本或直接下载版本："
          }
        }
      }
    },
    "The file is encrypted with your passphrase" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist mit deiner Passphrase verschlüsselt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se cifra con tu frase de contraseña"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier est chiffré avec votre phrase secrète"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはパスフレーズで暗号化されます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
